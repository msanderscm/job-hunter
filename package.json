{
  "name": "job-digest",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -k -n vite,wrangler -c blue,yellow \"vite build --watch\" \"wrangler dev --test-scheduled\"",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/worker",
    "db:migrate:local": "wrangler d1 migrations apply job-digest --local",
    "db:migrate:remote": "wrangler d1 migrations apply job-digest --remote",
    "cron:local": "curl \"http://localhost:8787/__scheduled?cron=0+6,10+*+*+*\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.124.0"
  }
}
